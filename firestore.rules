rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Check if the user is a seller
    function isSeller() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && isSeller() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (isSeller() && resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount']))
      );
      allow delete: if isAuthenticated() && isSeller() && resource.data.sellerId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      // Buyers and Sellers can read their own orders
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      
      // Only buyers can create orders, and they must be the buyer
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      
      // Both buyer and seller can update an order
      allow update: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      
      allow delete: if false;
    }

    match /wishlist/{wishlistId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /priceAlerts/{alertId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /inquiry_conversations/{conversationId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    match /inquiry_messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }
  }
}
